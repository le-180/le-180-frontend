---
import { getCollection } from 'astro:content';
import Main from '../../layouts/main.astro';
import { Image } from 'astro:assets';
const autoren = await getCollection('autor');
---

<Main pageTitle="Autoren">
    <h2 class="mt-10 text-3xl mx-auto">Autoren</h2>
    <div class="grid mt-5 lg:grid-cols-3 gap-y-14 lg:gap-10">
        {
            autoren.map((autor) => {
                return (
                    <a href={`/autoren/${autor.data.name.split(' ').join('-').toLowerCase()}`}>
                        <div class="flex space-x-3 items-center">
                            {autor.data.profilbild && (
                                <div class="avatar">
                                    <div class="w-24 rounded-full">
                                        <Image src={autor.data.profilbild} alt={'Profilbild von ' + autor.data.name} />
                                    </div>
                                </div>
                            )}
                            <div>
                                <h3 class="text-2xl font-bold">
                                    {autor.data.name}
                                    {/* {autor.data.nachname} */}
                                </h3>
                            </div>
                        </div>
                        <div class="flex mt-5 space-x-3">
                            <div class="flex flex-col">
                                <span class="font-medium" />
                                <span class="text-gray-500" />
                            </div>
                        </div>
                    </a>
                );
            })
        }
    </div>
</Main>
