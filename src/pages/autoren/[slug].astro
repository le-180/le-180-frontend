---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Main from '../../layouts/main.astro';
export async function getStaticPaths() {
    const autoren = await getCollection('autor');
    return autoren.map((autor) => ({
        params: { slug: autor.data.name.split(' ').join('-').toLowerCase() },
        props: autor,
    }));
}
const autor = Astro.props;
---

<Main pageTitle={autor.data.name}>
    <div class="grid grid-cols-1 gap-5">
        <div>
            <h1 class="text-4xl text-center mt-10">{autor.data.name}</h1>
        </div>
        <div class="mx-auto">
            <div class="avatar">
                <div class="w-24 rounded-full">
                    <Image src={autor.data.profilbild} alt={'Profilbild von ' + autor.data.name} />
                </div>
            </div>
        </div>
    </div>
</Main>
